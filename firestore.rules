rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'abdokamel200514@gmail.com'
      );
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'theme', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('theme' in data) || (data.theme in ['light', 'dark']))
        && (!('preferredLanguage' in data) || (data.preferredLanguage in ['en', 'ar']))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidResearchDataset(data, userId, datasetId) {
      return data.keys().hasAll([
          'datasetKey', 'ownerUid', 'name', 'layer', 'version',
          'license', 'isSyntheticDemo', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'datasetKey', 'ownerUid', 'name', 'description', 'layer', 'version',
          'license', 'isSyntheticDemo', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.datasetKey)
        && data.datasetKey == datasetId
        && isValidId(data.ownerUid)
        && data.ownerUid == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && data.layer in ['raw', 'processed', 'approved']
        && data.version is string && data.version.size() >= 1 && data.version.size() <= 32
        && data.license is string && data.license.size() >= 1 && data.license.size() <= 64
        && data.isSyntheticDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWritingSample(data, userId, sampleId) {
      return data.keys().hasAll([
          'sampleId', 'ownerUid', 'datasetKey', 'text', 'language',
          'originClass', 'validationStatus', 'verified', 'isSyntheticDemo',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'sampleId', 'ownerUid', 'datasetKey', 'text', 'language', 'domain',
          'originClass', 'validationStatus', 'verified', 'isSyntheticDemo',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.sampleId)
        && data.sampleId == sampleId
        && isValidId(data.ownerUid)
        && data.ownerUid == userId
        && isValidId(data.datasetKey)
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 20000
        && data.language is string && data.language.size() >= 2 && data.language.size() <= 16
        && (!('domain' in data) || (data.domain is string && data.domain.size() <= 64))
        && data.originClass in ['human', 'ai', 'human_edited_ai', 'ai_edited_human', 'mixed', 'unknown']
        && data.validationStatus in ['pending', 'verified', 'rejected', 'quarantined']
        && data.verified is bool
        && data.isSyntheticDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidResearchNote(data, userId, noteId) {
      return data.keys().hasAll(['noteId', 'ownerUid', 'title', 'content', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['noteId', 'ownerUid', 'title', 'content', 'tags', 'createdAt', 'updatedAt'])
        && isValidId(data.noteId)
        && data.noteId == noteId
        && isValidId(data.ownerUid)
        && data.ownerUid == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 15000
        && (!('tags' in data) || (
          data.tags is list
          && data.tags.size() <= 10
          && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40))
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'theme', 'preferredLanguage', 'updatedAt'])
        );
      allow delete: if isValidId(userId) && isAdmin();

      match /datasets/{datasetId} {
        allow get: if isValidId(userId) && isValidId(datasetId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin()) && resource.data.ownerUid == userId;
        allow create: if isValidId(userId) && isValidId(datasetId)
          && (isOwner(userId) || isAdmin())
          && isValidResearchDataset(incoming(), userId, datasetId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(datasetId)
          && (isOwner(userId) || isAdmin())
          && isValidResearchDataset(incoming(), userId, datasetId)
          && incoming().datasetKey == existing().datasetKey
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'layer', 'version', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(datasetId) && (isOwner(userId) || isAdmin());
      }

      match /samples/{sampleId} {
        allow get: if isValidId(userId) && isValidId(sampleId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin()) && resource.data.ownerUid == userId;
        allow create: if isValidId(userId) && isValidId(sampleId)
          && (isOwner(userId) || isAdmin())
          && isValidWritingSample(incoming(), userId, sampleId)
          && exists(/databases/$(database)/documents/users/$(userId)/datasets/$(incoming().datasetKey))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(sampleId)
          && (isOwner(userId) || isAdmin())
          && isValidWritingSample(incoming(), userId, sampleId)
          && incoming().sampleId == existing().sampleId
          && incoming().ownerUid == existing().ownerUid
          && incoming().datasetKey == existing().datasetKey
          && incoming().isSyntheticDemo == existing().isSyntheticDemo
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || (
              existing().validationStatus != 'rejected'
              && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'domain', 'originClass', 'validationStatus', 'verified', 'updatedAt'])
            )
          );
        allow delete: if isValidId(userId) && isValidId(sampleId) && (isOwner(userId) || isAdmin());
      }

      match /notes/{noteId} {
        allow get: if isValidId(userId) && isValidId(noteId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin()) && resource.data.ownerUid == userId;
        allow create: if isValidId(userId) && isValidId(noteId)
          && (isOwner(userId) || isAdmin())
          && isValidResearchNote(incoming(), userId, noteId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(noteId)
          && (isOwner(userId) || isAdmin())
          && isValidResearchNote(incoming(), userId, noteId)
          && incoming().noteId == existing().noteId
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'tags', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(noteId) && (isOwner(userId) || isAdmin());
      }
    }
  }
}
